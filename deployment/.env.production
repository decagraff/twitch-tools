# Database
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/twitch_dev_hub?schema=public"

# JWT
JWT_SECRET="tu_jwt_secret_aqui_muy_seguro_cambialo"

# Encryption (AES-256-GCM)
ENCRYPTION_KEY="tu_encryption_key_de_32_caracteres_aqui_cambialo_por_seguridad"

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (para CORS)
FRONTEND_URL="http://tu_dominio_o_ip"

# Optional: Twitch API (si necesitas configuración global)
# TWITCH_CLIENT_ID="tu_client_id"
# TWITCH_CLIENT_SECRET="tu_client_secret"
